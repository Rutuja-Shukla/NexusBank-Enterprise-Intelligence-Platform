{
  "Database": {
    "Provider": "SqlServer",
    "AutoMigrate": true,
    "AutoSeed": true
  },
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=NexusBank;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=False",
    "Sqlite": "Data Source=nexusbank.db"
  },
  "Jwt": {
    "Issuer": "nexusbank-api",
    "Audience": "nexusbank-console",
    "SigningKey": "",
    "AccessTokenMinutes": 30
  },
  "Redis": {
    "Enabled": true,
    "Configuration": "localhost:6379"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "ClientId": "nexusbank-api",
    "ConsumerGroupId": "nexusbank-platform-consumers",
    "ConnectionTimeoutMs": 3000
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4173", "http://localhost:8080" ]
  },
  "RateLimiting": {
    "PermitLimit": 600,
    "AuthPermitLimit": 12
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Api": {
    "SelfBaseUrl": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
