# Copy to .env (never commit .env) and replace every placeholder.
# Required by docker compose up.

# SQL Server 2022 requires a strong password: 8+ chars, upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Passw0rd

# Minimum 32 bytes of entropy. Generate with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-at-least-32-bytes-of-random-data

# Optional: OTLP collector endpoint (Jaeger, Grafana Tempo, Azure Monitor agent).
OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Backend configuration reference (environment variable form of appsettings.json)
# ---------------------------------------------------------------------------
# Database__Provider=SqlServer|Sqlite
# Database__AutoMigrate=true
# Database__AutoSeed=true
# ConnectionStrings__SqlServer=Server=localhost,1433;Database=NexusBank;User Id=sa;Password=...;TrustServerCertificate=True
# ConnectionStrings__Sqlite=Data Source=nexusbank-dev.db
# Jwt__SigningKey=...            (required outside Development)
# Jwt__Issuer=nexusbank-api
# Jwt__Audience=nexusbank-console
# Jwt__AccessTokenMinutes=30
# Redis__Enabled=true
# Redis__Configuration=localhost:6379
# Kafka__Enabled=true
# Kafka__BootstrapServers=localhost:9092
# Kafka__ConsumerGroupId=nexusbank-platform-consumers
# Cors__AllowedOrigins__0=http://localhost:5173
# RateLimiting__PermitLimit=600
# RateLimiting__AuthPermitLimit=12
# OpenTelemetry__OtlpEndpoint=http://otel-collector:4317
# Api__SelfBaseUrl=            (blank = derive from the incoming request)

# ---------------------------------------------------------------------------
# Frontend (Vite, build-time)
# ---------------------------------------------------------------------------
# VITE_API_TARGET=http://localhost:8080   (dev-server proxy only)
